---
import Base from '../layouts/Base.astro';
import { contacts } from '../data/brands';
---

<Base
  title="Contact - Cenovya Labs"
  description="Reach Cenovya Labs LLC by email. App support goes to the app it belongs to; company, press, and legal reach us directly."
>
  <section class="container pb-16 pt-20 sm:pt-28">
    <p class="eyebrow" data-reveal>Contact</p>
    <h1 class="display display--page mt-6 max-w-3xl" data-reveal style="--reveal-delay: 60ms">
      Email is the only channel.
    </h1>
    <p class="lede mt-8 max-w-xl" data-reveal style="--reveal-delay: 120ms">
      Pick the address that gets you the fastest answer. App support goes to the app it belongs to.
    </p>
  </section>

  <section class="container pb-24 sm:pb-32">
    <dl class="mt-4">
      {
        contacts.map((contact, i) => (
          <div
            class="group grid gap-2 border-t border-line py-7 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
            data-reveal
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <dt class="prose-muted text-[0.9375rem]">{contact.for}</dt>
            <dd>
              <a
                href={`mailto:${contact.email}`}
                class="font-[family-name:var(--font-display)] text-lg text-forest-900 transition-colors hover:text-leaf-600"
              >
                {contact.email}
              </a>
            </dd>
          </div>
        ))
      }
      <div class="border-t border-line"></div>
    </dl>

    <p class="prose-muted mt-10 max-w-xl text-sm" data-reveal>
      There is no mailing address or phone number on this site. Those are filed with Apple and Google
      as trader information, where they are required.
    </p>
  </section>
</Base>
