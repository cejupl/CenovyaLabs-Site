---
import Base from '../layouts/Base.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { entity } from '../config';
import { brands, principles } from '../data/brands';
---

<Base>
  {/* ------------------------------------------------------------- hero --- */}
  <section class="relative overflow-hidden">
    {/* A single, very quiet leaf-green wash. The only decoration on the page. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-[18%] -top-[55%] h-[54rem] w-[54rem] rounded-full opacity-[0.06] blur-3xl"
      style="background: radial-gradient(circle, var(--color-leaf-500), transparent 62%)"
    >
    </div>

    <div class="container relative pb-20 pt-20 sm:pb-28 sm:pt-32">
      <p class="eyebrow" data-reveal>{entity.legalName}</p>

      <h1 class="display display--hero mt-6" data-reveal style="--reveal-delay: 60ms">
        Software made to matter.
      </h1>

      <p class="lede measure mt-8" data-reveal style="--reveal-delay: 130ms">
        Cenovya Labs builds consumer applications across different sectors.
      </p>

      {/* Set below the lede rather than at its size - three paragraphs of hero-scale
          type would read as a wall. The descent headline > lede > detail is the point. */}
      <div class="measure mt-6 space-y-4" data-reveal style="--reveal-delay: 190ms">
        <p class="prose-muted">
          Built on modern, actively supported technology, each product is rigorously tested,
          continuously maintained, and designed with security and data protection at its core.
          Customers receive timely, reliable support throughout the product lifecycle.
        </p>
        <p class="prose-muted">
          Every product follows the same rules: no ad SDKs, no data brokers, no dark patterns.
        </p>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-10 gap-y-4" data-reveal style="--reveal-delay: 250ms">
        <ArrowLink href="/about" label="About the company" />
        <ArrowLink href="/contact" label="Get in touch" />
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- brands --- */}
  <section class="section border-t border-line" id="brands">
    <div class="container">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
        <div>
          <p class="eyebrow">What we build</p>
          <h2 class="display display--section mt-3">
            Health and games.
            <span class="text-[0.5em] text-muted">More sectors to come.</span>
          </h2>
        </div>
        <p class="prose-muted max-w-sm text-sm sm:text-right">Each label runs on its own site.</p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {
          brands.map((brand, i) => (
            <article
              class="card"
              style={`--card-accent: var(--color-${brand.accent === 'leaf' ? 'leaf-500' : 'forest-800'}); --reveal-delay: ${i * 90}ms`}
              data-reveal
            >
              <p class="eyebrow flex items-center gap-2.5">
                <span class="dot" />
                {brand.category}
              </p>

              <h3 class="display text-[clamp(1.5rem,2.6vw,2rem)]">{brand.name}</h3>

              <p class="prose-muted flex-1">{brand.blurb}</p>

              <p class="text-sm font-medium text-forest-800">{brand.status}</p>

              <div class="pt-1">
                <ArrowLink href={brand.url} label={brand.urlLabel} external />
              </div>

              {brand.note && <p class="text-xs leading-relaxed text-muted/80">{brand.note}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- principles --- */}
  <section class="section bg-paper-soft border-t border-line">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">How we work</p>
        <h2 class="display display--section mt-3 max-w-2xl">Three rules, held to on both sides.</h2>
      </div>

      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          principles.map((principle, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <div class="mb-6 h-px w-full bg-line" />
              <p class="font-[family-name:var(--font-display)] text-sm font-medium tracking-[0.18em] text-leaf-600">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="display mt-4 text-xl">{principle.title}</h3>
              <p class="prose-muted mt-3 text-[0.9375rem]">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- closing --- */}
  <section class="section border-t border-line">
    <div class="container">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <div class="max-w-xl">
          <h2 class="display display--section">Say hello.</h2>
          <p class="prose-muted mt-4">
            Support questions go to the app they belong to. Everything else reaches the company
            directly.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-x-10 gap-y-4">
          <ArrowLink href="/contact" label="Contact" />
          <ArrowLink href={`mailto:${entity.emails.general}`} label={entity.emails.general} />
        </div>
      </div>
    </div>
  </section>
</Base>
