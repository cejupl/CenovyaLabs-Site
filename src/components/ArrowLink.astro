---
interface Props {
  href: string;
  label: string;
  /** Adds the target/rel pair for links that leave the site. */
  external?: boolean;
}

const { href, label, external = false } = Astro.props;
---

<a
  class="link-out"
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span>{label}</span>
  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
    <path
      d="M3 7.5h9m0 0L8.5 4M12 7.5 8.5 11"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>
